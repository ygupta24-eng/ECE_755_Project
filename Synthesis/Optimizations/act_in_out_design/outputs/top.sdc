###################################################################
set sdc_version 2.2

set_units -time ps -resistance kOhm -capacitance fF -voltage V -current mA
set_wire_load_mode segmented
set_max_fanout 128 [current_design]
set_load -pin_load 0.01 [get_ports done]
set_load -pin_load 0.01 [get_ports {psum_out0[12]}]
set_load -pin_load 0.01 [get_ports {psum_out0[11]}]
set_load -pin_load 0.01 [get_ports {psum_out0[10]}]
