digraph "top" {
label="top";
rankdir="LR";
remincross=true;
n1 [ shape=diamond, label="direction", color="black", fontcolor="black" ];
n2 [ shape=diamond, label="psum_clr", color="black", fontcolor="black" ];
n3 [ shape=diamond, label="psum_shift_en", color="black", fontcolor="black" ];
n4 [ shape=diamond, label="fifo_en", color="black", fontcolor="black" ];
n5 [ shape=diamond, label="w_ld_en", color="black", fontcolor="black" ];
n6 [ shape=diamond, label="move_en", color="black", fontcolor="black" ];
n7 [ shape=diamond, label="en", color="black", fontcolor="black" ];
n8 [ shape=octagon, label="psum_out1", color="black", fontcolor="black" ];
n9 [ shape=octagon, label="psum_out0", color="black", fontcolor="black" ];
n10 [ shape=octagon, label="w_in_flat", color="black", fontcolor="black" ];
n11 [ shape=octagon, label="v_in1", color="black", fontcolor="black" ];
n12 [ shape=octagon, label="v_in0", color="black", fontcolor="black" ];
n13 [ shape=octagon, label="h_in1", color="black", fontcolor="black" ];
n14 [ shape=octagon, label="h_in0", color="black", fontcolor="black" ];
n15 [ shape=octagon, label="done", color="black", fontcolor="black" ];
n16 [ shape=octagon, label="start", color="black", fontcolor="black" ];
n17 [ shape=octagon, label="rst_n", color="black", fontcolor="black" ];
n18 [ shape=octagon, label="clk", color="black", fontcolor="black" ];
c19 [ shape=record, label="{{<p18> clk|<p1> direction|<p7> en|<p4> fifo_en|<p14> h_in0|<p13> h_in1|<p6> move_en|<p2> psum_clr|<p3> psum_shift_en|<p17> rst_n|<p12> v_in0|<p11> v_in1|<p10> w_in_flat|<p5> w_ld_en}|u_pe_array\nzig_zag_4x4|{<p9> psum_out0|<p8> psum_out1}}",  ];
c20 [ shape=record, label="{{<p18> clk|<p17> rst_n|<p16> start}|u_fsm\nzigzag_fsm|{<p1> direction|<p15> done|<p7> en|<p4> fifo_en|<p6> move_en|<p2> psum_clr|<p3> psum_shift_en|<p5> w_ld_en}}",  ];
c20:p1:e -> n1:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
