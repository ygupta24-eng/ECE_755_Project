n14:e -> c19:p14:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c20:p15:e -> n15:w [color="black", fontcolor="black", label=""];
n16:e -> c20:p16:w [color="black", fontcolor="black", label=""];
n17:e -> c19:p17:w [color="black", fontcolor="black", label=""];
n17:e -> c20:p17:w [color="black", fontcolor="black", label=""];
n18:e -> c19:p18:w [color="black", fontcolor="black", label=""];
